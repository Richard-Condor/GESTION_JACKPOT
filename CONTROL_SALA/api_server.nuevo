function GH-LoadManifest {
    if (Test-Path $GH_ManifestFile) {
        try {
            $j = Get-Content $GH_ManifestFile -Raw -Encoding UTF8 | ConvertFrom-Json
            $h = @{}
            $j.PSObject.Properties | ForEach-Object { $h[$_.Name] = $_.Value }
            $script:GH_Manifest = $h
        } catch { $script:GH_Manifest = @{} }
    }
}

function GH-SaveManifest {
    try { $script:GH_Manifest | ConvertTo-Json | Set-Content $GH_ManifestFile -Force -Encoding UTF8 -ErrorAction SilentlyContinue } catch {}
}

function Invoke-GHControlCheck {
    if (-not $GH_TokenPlain -or $GH_TokenPlain -eq "") { return }
    if (((Get-Date) - $script:GH_LastCheck).TotalMinutes -lt $GH_CheckEveryMin) { return }
    $script:GH_LastCheck = Get-Date

    Write-ApiLog "GitHub: comprobando repo GESTION_JACKPOT/$GH_Folder..."
    try {
        try { [Net.ServicePointManager]::SecurityProtocol = 3072 } catch {}
        $url = "https://api.github.com/repos/$GH_Repo/contents/$GH_Folder"
        $req = [System.Net.HttpWebRequest]::Create($url)
        $req.Method    = "GET"
        $req.Timeout   = 30000
        $req.UserAgent = "CalimaAPIServer"
        $req.Accept    = "application/vnd.github.v3+json"
        $req.Proxy     = [System.Net.WebRequest]::GetSystemWebProxy()
        $req.Proxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
        $req.Headers.Add("Authorization", "token $GH_TokenPlain")
        $resp   = $req.GetResponse()
        $reader = New-Object System.IO.StreamReader($resp.GetResponseStream())
        $json   = $reader.ReadToEnd()
        $reader.Close(); $resp.Close()
        $files = $json | ConvertFrom-Json
    } catch {
        $inner = if ($_.Exception.InnerException) { $_.Exception.InnerException.Message } else { $_.Exception.Message }
        Write-ApiLog "GitHub: fallo al consultar repo: $($inner.Substring(0, [Math]::Min($inner.Length, 200)))"
        return
    }

    $allFiles = @($files | Where-Object { $_.type -eq "file" })
    $pending  = $allFiles | Where-Object {
        $_.name -ne "no_borrar.txt" -and
        $script:GH_Manifest[$_.name] -ne $_.sha
    }

    if (-not $pending -or $pending.Count -eq 0) {
        Write-ApiLog "GitHub: sin cambios pendientes."
        return
    }

    Write-ApiLog "GitHub: $($pending.Count) fichero(s) nuevo(s) detectado(s)."
    $needsRestart = $false
    $scriptEntry  = $null

    foreach ($f in $pending) {
        try {
            $tmp = Join-Path $env:TEMP ("ghc_" + [System.IO.Path]::GetRandomFileName())
            $dlReq = [System.Net.HttpWebRequest]::Create($f.download_url)
            $dlReq.Method    = "GET"
            $dlReq.Timeout   = 60000
            $dlReq.UserAgent = "CalimaAPIServer"
            $dlReq.Proxy     = [System.Net.WebRequest]::GetSystemWebProxy()
            $dlReq.Proxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
            $dlReq.Headers.Add("Authorization", "token $GH_TokenPlain")
            $dlResp   = $dlReq.GetResponse()
            $dlReader = New-Object System.IO.BinaryReader($dlResp.GetResponseStream())
            $bytes    = $dlReader.ReadBytes([int]$dlResp.ContentLength)
            $dlReader.Close(); $dlResp.Close()
            [System.IO.File]::WriteAllBytes($tmp, $bytes)

            if ($f.name -ieq "script.ps1") {
                # Ejecucion puntual: no copia, solo ejecuta
                $scriptEntry = @{ Path = $tmp; SHA = $f.sha }
                Write-ApiLog "GitHub: script.ps1 descargado, pendiente de ejecutar."
            } else {
                # Cualquier otro fichero (api_server.ps1, panel.html, etc.) -> copia a C:\Control
                $dest = Join-Path $ControlPath $f.name
                Copy-Item $tmp $dest -Force -ErrorAction Stop
                $script:GH_Manifest[$f.name] = $f.sha
                Write-ApiLog "GitHub: $($f.name) copiado a $ControlPath."
                $needsRestart = $true
            }
        } catch {
            Write-ApiLog "GitHub: error procesando '$($f.name)': $($_.Exception.Message)"
        } finally {
            if ($f.name -ine "script.ps1") { Remove-Item $tmp -Force -ErrorAction SilentlyContinue }
        }
    }

    # Ejecutar script.ps1 si habia uno pendiente
    if ($scriptEntry) {
        try {
            Write-ApiLog "GitHub: ejecutando script.ps1..."
            Start-Process powershell.exe `
                -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$($scriptEntry.Path)`"" `
                -Wait -NoNewWindow -ErrorAction Stop
            $script:GH_Manifest["script.ps1"] = $scriptEntry.SHA
            Write-ApiLog "GitHub: script.ps1 ejecutado correctamente."
        } catch {
            Write-ApiLog "GitHub: error ejecutando script.ps1: $($_.Exception.Message)"
        } finally {
            Remove-Item $scriptEntry.Path -Force -ErrorAction SilentlyContinue
        }
    }

    GH-SaveManifest

    # Si se copio algun fichero de infra -> suicidio controlado (watchdog relanza con ficheros nuevos)
    if ($needsRestart) {
        Write-ApiLog "GitHub: ficheros de infra actualizados. Reiniciando proceso para aplicar cambios..."
        Start-Sleep 2
        exit 0
    }
}

# Carga el manifest al arrancar
GH-LoadManifest
if ($GH_TokenPlain -and $GH_TokenPlain -ne "") {
    Write-ApiLog "GitHub auto-updater activo. Repo: $GH_Repo/$GH_Folder (cada $GH_CheckEveryMin min)"
}

# Lanzar checker de GitHub en hilo separado para no bloquear el listener HTTP
$ghRunspace = $null
if ($GH_TokenPlain -and $GH_TokenPlain -ne "") {
    $ghRunspace = [System.Management.Automation.PowerShell]::Create()
    $ghRunspace.AddScript({
        param($GH_Repo, $GH_Folder, $GH_TokenPlain, $GH_CheckEveryMin, $GH_ManifestFile, $ControlPath, $LogFile)
        $manifest = @{}
        if (Test-Path $GH_ManifestFile) {
            try { $j = Get-Content $GH_ManifestFile -Raw -Encoding UTF8 | ConvertFrom-Json; $j.PSObject.Properties | ForEach-Object { $manifest[$_.Name] = $_.Value } } catch {}
        }
        $infraFiles = @("api_server.ps1", "panel.html", "watchdog_api.ps1")
        function GH-Log { param([string]$m); $l = "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $m"; Add-Content $LogFile $l -Encoding UTF8 -ErrorAction SilentlyContinue; Write-Host $l }
        while ($true) {
            Start-Sleep ($GH_CheckEveryMin * 60)
            GH-Log "GitHub: comprobando repo $GH_Repo/$GH_Folder..."
            try {
                try { [Net.ServicePointManager]::SecurityProtocol = 3072 } catch {}
                $req = [System.Net.HttpWebRequest]::Create("https://api.github.com/repos/$GH_Repo/contents/$GH_Folder")
                $req.Method = "GET"; $req.Timeout = 30000; $req.UserAgent = "CalimaAPIServer"
                $req.Accept = "application/vnd.github.v3+json"
                $req.Proxy = [System.Net.WebRequest]::GetSystemWebProxy()
                $req.Proxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
                $req.Headers.Add("Authorization", "token $GH_TokenPlain")
                $resp = $req.GetResponse()
                $reader = New-Object System.IO.StreamReader($resp.GetResponseStream())
                $files = $reader.ReadToEnd() | ConvertFrom-Json
                $reader.Close(); $resp.Close()
            } catch { GH-Log "GitHub: fallo al consultar repo: $($_.Exception.Message)"; continue }

            $pending = @($files | Where-Object { $_.type -eq "file" -and $_.name -ne "no_borrar.txt" -and $manifest[$_.name] -ne $_.sha })
            if ($pending.Count -eq 0) { GH-Log "GitHub: sin cambios pendientes."; continue }
            GH-Log "GitHub: $($pending.Count) fichero(s) nuevo(s) detectado(s)."

            $needsRestart = $false
            $scriptEntry  = $null

            foreach ($f in $pending) {
                try {
                    $tmp = Join-Path $env:TEMP ("ghc_" + [System.IO.Path]::GetRandomFileName())
                    $dlReq = [System.Net.HttpWebRequest]::Create($f.download_url)
                    $dlReq.Method = "GET"; $dlReq.Timeout = 60000; $dlReq.UserAgent = "CalimaAPIServer"
                    $dlReq.Proxy = [System.Net.WebRequest]::GetSystemWebProxy()
                    $dlReq.Proxy.Credentials = [System.Net.CredentialCache]::DefaultNetworkCredentials
                    $dlReq.Headers.Add("Authorization", "token $GH_TokenPlain")
                    $dlResp = $dlReq.GetResponse()
                    $dlReader = New-Object System.IO.BinaryReader($dlResp.GetResponseStream())
                    $bytes = $dlReader.ReadBytes([int]$dlResp.ContentLength)
                    $dlReader.Close(); $dlResp.Close()
                    [System.IO.File]::WriteAllBytes($tmp, $bytes)

                    if ($f.name -ieq "script.ps1") {
                        $scriptEntry = @{ Path = $tmp; SHA = $f.sha }
                        GH-Log "GitHub: script.ps1 descargado, pendiente de ejecutar."
                    } else {
                        $dest = Join-Path $ControlPath $f.name
                        Copy-Item $tmp $dest -Force -ErrorAction Stop
                        $manifest[$f.name] = $f.sha
                        GH-Log "GitHub: $($f.name) copiado a $ControlPath."
                        if ($infraFiles -contains $f.name) { $needsRestart = $true }
                    }
                } catch {
                    GH-Log "GitHub: error procesando '$($f.name)': $($_.Exception.Message)"
                } finally {
                    if ($f.name -ine "script.ps1") { Remove-Item $tmp -Force -ErrorAction SilentlyContinue }
                }
            }

            if ($scriptEntry) {
                try {
                    GH-Log "GitHub: ejecutando script.ps1..."
                    Start-Process powershell.exe -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$($scriptEntry.Path)`"" -Wait -NoNewWindow -ErrorAction Stop
                    $manifest["script.ps1"] = $scriptEntry.SHA
                    GH-Log "GitHub: script.ps1 ejecutado correctamente."
                } catch { GH-Log "GitHub: error ejecutando script.ps1: $($_.Exception.Message)" }
                finally { Remove-Item $scriptEntry.Path -Force -ErrorAction SilentlyContinue }
            }

            try { $manifest | ConvertTo-Json | Set-Content $GH_ManifestFile -Force -Encoding UTF8 } catch {}

            if ($needsRestart) {
                GH-Log "GitHub: ficheros de infra actualizados. Reiniciando proceso para aplicar cambios..."
                Start-Sleep 2
                exit 0
            }
        }
    }).AddParameters(@{
        GH_Repo          = $GH_Repo
        GH_Folder        = $GH_Folder
        GH_TokenPlain    = $GH_TokenPlain
        GH_CheckEveryMin = $GH_CheckEveryMin
        GH_ManifestFile  = $GH_ManifestFile
        ControlPath      = $ControlPath
        LogFile          = $LogFile
    })
    $ghRunspace.BeginInvoke() | Out-Null
}

