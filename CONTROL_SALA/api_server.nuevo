function Test-IpPrivada {
    # La web del operador solo existe dentro de casa: rangos privados
    # (10/8, 172.16/12, 192.168/16) y la propia maquina. Cualquier IP
    # publica queda fuera, venga de donde venga.
    param([string]$IpStr)
    if (-not $IpStr) { return $false }
    $s = $IpStr.Trim()
    if ($s.StartsWith("::ffff:")) { $s = $s.Substring(7) }
    if ($s -eq "::1") { return $true }
    $ipObj = $null
    if (-not [System.Net.IPAddress]::TryParse($s, [ref]$ipObj)) { return $false }
    $b = $ipObj.GetAddressBytes()
    if ($b.Length -ne 4) { return $false }
    if ($b[0] -eq 10) { return $true }
    if ($b[0] -eq 172 -and $b[1] -ge 16 -and $b[1] -le 31) { return $true }
    if ($b[0] -eq 192 -and $b[1] -eq 168) { return $true }
    if ($b[0] -eq 127) { return $true }
    return $false
}

function Send-Response {
    param($Response, [string]$Body, [string]$ContentType = "application/json; charset=utf-8", [int]$Status = 200)
    $Response.StatusCode  = $Status
    $Response.ContentType = $ContentType
    $buffer = [System.Text.Encoding]::UTF8.GetBytes($Body)
    $Response.ContentLength64 = $buffer.Length
    $Response.OutputStream.Write($buffer, 0, $buffer.Length)
    $Response.Close()
}

function Get-KiosksRaw {
    # Lee los JSON de los kiosks SIN sondear la red (rapido, para envios masivos)
    $all = @()
    Get-ChildItem -Path $KiosksPath -Filter "*.json" -ErrorAction SilentlyContinue | ForEach-Object {
        try {
            $k = Get-Content $_.FullName -Raw -Encoding UTF8 | ConvertFrom-Json
            if (-not $k.uid) { Remove-Item -Path $_.FullName -Force -ErrorAction SilentlyContinue }
            else { $all += $k }
        } catch {}
    }
    return $all
}

# Cache breve del sondeo de red (evita repetir pasadas si el panel pide seguido)
$script:RedCache = @{}

function Test-RedParalelo {
    # Sondea TODAS las IPs a la vez (ping async y, si falla, TCP/135 async).
    # Antes: un ping en serie por IP (300 ms) + TCP en serie; con la flota
    # apagada la pasada duraba decenas de segundos bloqueando el servidor.
    # Ahora la pasada completa tarda ~1,4 s en el peor caso.
    param([string[]]$IPs)
    $resultado = @{}
    $pendientes = @()
    $ahora = Get-Date
    foreach ($ip in $IPs) {
        if ($script:RedCache.ContainsKey($ip) -and (($ahora - $script:RedCache[$ip].T).TotalSeconds -lt 5)) {
            $resultado[$ip] = $script:RedCache[$ip].Ok
        } else { $pendientes += $ip }
    }
    if ($pendientes.Count -gt 0) {
        $pings = @{}
        foreach ($ip in $pendientes) {
            $p = New-Object System.Net.NetworkInformation.Ping
            $pings[$ip] = @{ Ping = $p; Task = $p.SendPingAsync($ip, 600) }
        }
        try { [System.Threading.Tasks.Task]::WaitAll([System.Threading.Tasks.Task[]]@($pings.Values | ForEach-Object { $_.Task }), 700) | Out-Null } catch {}
        $sinPing = @()
        foreach ($ip in $pendientes) {
            $ok = $false
            try { if ($pings[$ip].Task.IsCompleted -and -not $pings[$ip].Task.IsFaulted -and $pings[$ip].Task.Result.Status -eq 'Success') { $ok = $true } } catch {}
            $pings[$ip].Ping.Dispose()
            if ($ok) { $resultado[$ip] = $true } else { $sinPing += $ip }
        }
        if ($sinPing.Count -gt 0) {
            $tcps = @{}
            foreach ($ip in $sinPing) {
                $t = New-Object System.Net.Sockets.TcpClient
                $tcps[$ip] = @{ Tcp = $t; Task = $t.ConnectAsync($ip, 135) }
            }
            try { [System.Threading.Tasks.Task]::WaitAll([System.Threading.Tasks.Task[]]@($tcps.Values | ForEach-Object { $_.Task }), 700) | Out-Null } catch {}
            foreach ($ip in $sinPing) {
                $ok = $false
                try { if ($tcps[$ip].Task.IsCompleted -and -not $tcps[$ip].Task.IsFaulted) { $ok = $tcps[$ip].Tcp.Connected } } catch {}
                $tcps[$ip].Tcp.Close()
                $resultado[$ip] = $ok
            }
        }
        foreach ($ip in $pendientes) { $script:RedCache[$ip] = @{ T = Get-Date; Ok = [bool]$resultado[$ip] } }
    }
    return $resultado
}

function Get-AllKiosks {
    # v2: ya NO se sobrescribe ultima_conexion con el ping. El estado sale de:
    #  - responde_red: la red contesta (ping o TCP/135, en paralelo)
    #  - segundos_sin_reporte: antiguedad real del ultimo check-in del kiosk
    #  - push_estado: resultado del ultimo intento de despertar al kiosk
    $all = @(Get-KiosksRaw)
    $ips = @($all | ForEach-Object { $_.ip_actual } | Where-Object { $_ } | Select-Object -Unique)
    $red = @{}
    if ($ips.Count -gt 0) { $red = Test-RedParalelo $ips }
    foreach ($k in $all) {
        $responde = $false
        if ($k.ip_actual -and $red.ContainsKey($k.ip_actual)) { $responde = [bool]$red[$k.ip_actual] }
        $k | Add-Member -MemberType NoteProperty -Name "responde_red" -Value $responde -Force
        $seg = $null
        if ($k.ultima_conexion) {
            try { $seg = [int]((Get-Date) - [datetime]::Parse($k.ultima_conexion)).TotalSeconds; if ($seg -lt 0) { $seg = 0 } } catch { $seg = $null }
        }
        $k | Add-Member -MemberType NoteProperty -Name "segundos_sin_reporte" -Value $seg -Force
        $pe = $null
        if ($script:PushEstados -and $k.ip_actual -and $script:PushEstados.ContainsKey($k.ip_actual)) { $pe = $script:PushEstados[$k.ip_actual] }
        $k | Add-Member -MemberType NoteProperty -Name "push_estado" -Value $pe -Force
    }
    # Correccion 2026-10-16: duplicados por matricula o por nombre.
    # Si dos JSON comparten matricula o nombre y al menos uno
    # responde a red, los que no responden son restos de una IP
    # anterior y se ocultan
    # de la lista (el fichero NO se borra: la limpieza fisica la hace
    # la campana moviendo el JSON a cuarentena). Si ninguno responde,
    # se muestran todos: sin red no se puede saber cual es el bueno.
    try {
        $ocultos = @{}
        $gruposM = @{}
        $gruposN = @{}
        foreach ($k in $all) {
            if ($k.matricula -and $k.matricula -notmatch "PLANETAS|SIGNAGE|CALENDARIO") {
                if (-not $gruposM.ContainsKey($k.matricula)) { $gruposM[$k.matricula] = @() }
                $gruposM[$k.matricula] += $k
            }
            if ($k.nombre_maquina -and $k.nombre_maquina -notmatch "PLANETAS|SIGNAGE|CALENDARIO") {
                if (-not $gruposN.ContainsKey($k.nombre_maquina)) { $gruposN[$k.nombre_maquina] = @() }
                $gruposN[$k.nombre_maquina] += $k
            }
        }
        foreach ($grupos in @($gruposM, $gruposN)) {
            foreach ($clave in $grupos.Keys) {
                $g = @($grupos[$clave])
                if ($g.Count -lt 2) { continue }
                if (@($g | Where-Object { $_.responde_red }).Count -lt 1) { continue }
                foreach ($k in $g) { if (-not $k.responde_red) { $ocultos[$k.uid] = $true } }
            }
        }
        if ($ocultos.Count -gt 0) { $all = @($all | Where-Object { -not $ocultos.ContainsKey($_.uid) }) }
    } catch {}
    return $all
}

function Get-KioskFile { param([string]$Uid); return "$KiosksPath\$Uid.json" }
function Read-KioskData {
    param([string]$Uid)
    $f = Get-KioskFile $Uid
    if (Test-Path $f) { try { return Get-Content $f -Raw -Encoding UTF8 | ConvertFrom-Json } catch {} }
    return $null
}
function Save-KioskData {
    param([string]$Uid, [object]$Data)
    $f = Get-KioskFile $Uid
    $Data | ConvertTo-Json -Depth 10 | Set-Content -Path $f -Encoding UTF8 -Force
}
function New-KioskData {
    param([string]$Uid)
    return [PSCustomObject]@{
        uid             = $Uid
        matricula       = ""
        nombre_maquina  = ""
        ip_actual       = ""
        hostname        = ""
        puesto          = ""
        ultima_conexion = ""
        comandos_pendientes = [PSCustomObject]@{
            cambiar_matricula   = ""
            actualizar_unity    = $false
            modificar_qr        = ""
            corregir_imagen     = $false
            reemplazar_setting  = $false
            cambiar_ip_servidor = ""
            reiniciar_app       = $false
            reiniciar_pc        = $false
            toggle_qr           = $null
            toggle_pv           = $null
            custom_qr           = ""
        }
    }
}

function Get-RequestBody {
    param($Request)
    try {
        $reader = New-Object System.IO.StreamReader($Request.InputStream, [System.Text.Encoding]::UTF8)
        $body = $reader.ReadToEnd(); $reader.Close()
        if ($body) { return $body | ConvertFrom-Json } else { return $null }
    } catch { return $null }
}

function Push-CommandToKiosk {
    param([string]$IP)
    $MisIPs = (Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue).IPAddress
    if ($MisIPs -contains $IP) {
        Start-Process "powershell.exe" -ArgumentList "-ExecutionPolicy Bypass -WindowStyle Hidden -File C:\Kiosk\control_kiosk.ps1 -ServerIP $IP_DEL_SERVIDOR"
        return
    }
    $cmd = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File C:\Kiosk\control_kiosk.ps1 -ServerIP $IP_DEL_SERVIDOR"
    Write-ApiLog "Enviando comando WMI a $IP..."
    try { 
        # Intentamos con un timeout mas corto para no bloquear el panel si el equipo no responde
        $opt = New-Object System.Management.ConnectionOptions
        $opt.Timeout = [TimeSpan]::FromSeconds(5)
        $scope = New-Object System.Management.ManagementScope("\\$IP\root\cimv2", $opt)
        $scope.Connect()
        
        Invoke-WmiMethod -ComputerName $IP -Class Win32_Process -Name Create -ArgumentList $cmd -ErrorAction Stop | Out-Null 
        Write-ApiLog "Comando enviado con exito a $IP (Sin credenciales)"
    }
    catch {
        Write-ApiLog "Fallo intento 1 en $IP. Probando con credenciales 1..."
        try {
            $securePass1 = ConvertTo-SecureString $Pass1 -AsPlainText -Force
            $cred1 = New-Object System.Management.Automation.PSCredential($User1, $securePass1)
            Invoke-WmiMethod -ComputerName $IP -Credential $cred1 -Class Win32_Process -Name Create -ArgumentList $cmd -ErrorAction Stop | Out-Null
            Write-ApiLog "Comando enviado con exito a $IP (Credenciales 1)"
        } catch {
            Write-ApiLog "Fallo intento 2 en $IP. Probando con credenciales 2..."
            try {
                $securePass2 = ConvertTo-SecureString $Pass2 -AsPlainText -Force
                $cred2 = New-Object System.Management.Automation.PSCredential($User2, $securePass2)
                Invoke-WmiMethod -ComputerName $IP -Credential $cred2 -Class Win32_Process -Name Create -ArgumentList $cmd -ErrorAction Stop | Out-Null
                Write-ApiLog "Comando enviado con exito a $IP (Credenciales 2)"
            } catch {
                Write-ApiLog "[!] ERROR CRITICO: No se pudo conectar con $IP tras todos los intentos: $($_.Exception.Message)"
            }
        }
    }
}

# ============================================================================
# COLA DE DESPERTAR WMI EN SEGUNDO PLANO (v2)
# Antes el empuje WMI se hacia DENTRO de la respuesta del POST: un equipo
# apagado retenia la respuesta segundos y un envio masivo tardaba ~40 s con
# la pantalla de "aceptar" congelada. Ahora el POST solo encola la IP y
# responde al instante; un hilo aparte despierta los kiosks uno a uno y
# anota el resultado en $PushEstados (lo lee el panel en /api/kiosks).
# ============================================================================
$script:PushCola    = New-Object 'System.Collections.Concurrent.ConcurrentQueue[string]'
$script:PushEstados = New-Object 'System.Collections.Concurrent.ConcurrentDictionary[string,string]'

function Push-Encolar {
    param([string]$IP)
    if (-not $IP) { return }
    $script:PushEstados[$IP] = "encolado|" + (Get-Date -Format 'HH:mm:ss')
    $script:PushCola.Enqueue($IP)
    Write-ApiLog "Comando encolado para $IP (despertar en segundo plano)"
}

$pushRunspace = [System.Management.Automation.PowerShell]::Create()
$pushRunspace.AddScript({
    param($Cola, $Estados, $SrvIP, $MisIPs, $U1, $P1, $U2, $P2, $LogFile)
    function W-Log { param([string]$m) try { Add-Content -Path $LogFile -Value "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $m" -Encoding UTF8 -ErrorAction SilentlyContinue } catch {} }
    function W-Push {
        param([string]$IP)
        if ($MisIPs -contains $IP) {
            try { Start-Process "powershell.exe" -ArgumentList "-ExecutionPolicy Bypass -WindowStyle Hidden -File C:\Kiosk\control_kiosk.ps1 -ServerIP $SrvIP" } catch {}
            return $true
        }
        $cmd = "powershell.exe -ExecutionPolicy Bypass -WindowStyle Hidden -File C:\Kiosk\control_kiosk.ps1 -ServerIP $SrvIP"
        W-Log "Enviando comando WMI a $IP..."
        try {
            $opt = New-Object System.Management.ConnectionOptions
            $opt.Timeout = [TimeSpan]::FromSeconds(5)
            $scope = New-Object System.Management.ManagementScope("\\$IP\root\cimv2", $opt)
            $scope.Connect()
            Invoke-WmiMethod -ComputerName $IP -Class Win32_Process -Name Create -ArgumentList $cmd -ErrorAction Stop | Out-Null
            W-Log "Comando enviado con exito a $IP (Sin credenciales)"
            return $true
        } catch {
            W-Log "Fallo intento 1 en $IP. Probando con credenciales 1..."
            try {
                $securePass1 = ConvertTo-SecureString $P1 -AsPlainText -Force
                $cred1 = New-Object System.Management.Automation.PSCredential($U1, $securePass1)
                Invoke-WmiMethod -ComputerName $IP -Credential $cred1 -Class Win32_Process -Name Create -ArgumentList $cmd -ErrorAction Stop | Out-Null
                W-Log "Comando enviado con exito a $IP (Credenciales 1)"
                return $true
            } catch {
                W-Log "Fallo intento 2 en $IP. Probando con credenciales 2..."
                try {
                    $securePass2 = ConvertTo-SecureString $P2 -AsPlainText -Force
                    $cred2 = New-Object System.Management.Automation.PSCredential($U2, $securePass2)
                    Invoke-WmiMethod -ComputerName $IP -Credential $cred2 -Class Win32_Process -Name Create -ArgumentList $cmd -ErrorAction Stop | Out-Null
                    W-Log "Comando enviado con exito a $IP (Credenciales 2)"
                    return $true
                } catch {
                    W-Log "[!] ERROR CRITICO: No se pudo conectar con $IP tras todos los intentos: $($_.Exception.Message)"
                    return $false
                }
            }
        }
    }
    while ($true) {
        $ip = ""
        if ($Cola.TryDequeue([ref]$ip)) {
            $ok = W-Push $ip
            $hora = Get-Date -Format 'HH:mm:ss'
            if ($ok) { $Estados[$ip] = "despierto|$hora" } else { $Estados[$ip] = "sin_respuesta|$hora" }
        } else {
            Start-Sleep -Milliseconds 400
        }
    }
}).AddParameters(@{
    Cola    = $script:PushCola
    Estados = $script:PushEstados
    SrvIP   = $IP_DEL_SERVIDOR
    MisIPs  = @((Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue).IPAddress)
    U1      = $User1
    P1      = $Pass1
    U2      = $User2
    P2      = $Pass2
    LogFile = $LogFile
})
$pushRunspace.BeginInvoke() | Out-Null
Write-ApiLog "Cola de despertar WMI en segundo plano: activa"

$listener = New-Object System.Net.HttpListener
$listener.Prefixes.Add("http://+:$Port/")
$listener.AuthenticationSchemes = [System.Net.AuthenticationSchemes]::Anonymous
$listener.Start()

while ($true) {
    try {
        $context = $listener.GetContext(); $request = $context.Request; $response = $context.Response; $method = $request.HttpMethod; $path = $request.Url.AbsolutePath.TrimEnd('/')

        $response.Headers.Add("Access-Control-Allow-Origin", "*"); $response.Headers.Add("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS"); $response.Headers.Add("Access-Control-Allow-Headers", "Content-Type, X-Api-Token")
        if ($method -eq "OPTIONS") { Send-Response $response "{}"; continue }

        # --- PUERTA API (solo si $ExigirLoginAPI o $ApiToken estan activos) ---
        # El panel entra con su cookie de sesion de siempre; el bot podra
        # entrar igual (login web) o con el token. Las rutas que usa el
        # kiosk (checkin, sync, GET comandos, POST clear) quedan fuera.
        # La sesion de OPERADOR entra solo desde red privada, solo puede
        # leer la lista y enviar comandos (el payload se limita despues).
        $esOperador = $false
        if (($ExigirLoginAPI -or $ApiToken -ne "") -and $path.StartsWith("/api/")) {
            $rutaKiosk = ($path -eq "/api/kiosk/checkin") -or ($path -eq "/api/kiosk/sync") -or ($path -match "^/api/kiosk/([^/]+)/commands$" -and $method -eq "GET") -or ($path -match "^/api/kiosk/([^/]+)/clear$" -and $method -eq "POST")
            if (-not $rutaKiosk) {
                $autorizado = $false
                $cookieHeader = $request.Headers["Cookie"]
                if ($cookieHeader -and $cookieHeader -match "session=([^;]+)" -and $matches[1] -eq $SessionToken) { $autorizado = $true }
                if ($ApiToken -ne "" -and $request.Headers["X-Api-Token"] -eq $ApiToken) { $autorizado = $true }
                if (-not $autorizado -and $cookieHeader -and $cookieHeader -match "operador=([^;]+)" -and $matches[1] -eq $OperadorToken) {
                    if ((Test-IpPrivada $request.RemoteEndPoint.Address.ToString()) -and
                        (($path -eq "/api/kiosks" -and $method -eq "GET") -or ($path -match "^/api/kiosk/([^/]+)/commands$" -and $method -eq "POST"))) {
                        $autorizado = $true; $esOperador = $true
                    }
                }
                if (-not $autorizado) { Send-Response $response '{"error":"no autorizado"}' -Status 401; continue }
            }
        }

        if ($path -eq "/login" -and $method -eq "GET") {
            Send-Response $response ($LoginPage -replace '{{ERROR}}','') "text/html"
        }
        elseif ($path -eq "/login" -and $method -eq "POST") {
            $formBody = ""
            try { $r2 = New-Object System.IO.StreamReader($request.InputStream); $formBody = $r2.ReadToEnd(); $r2.Close() } catch {}
            $u = ""; $p = ""
            foreach ($pair in $formBody.Split('&')) {
                $kv = $pair.Split('=',2)
                if ($kv.Count -eq 2) {
                    $val = [System.Uri]::UnescapeDataString($kv[1].Replace('+',' '))
                    if ($kv[0] -eq 'u') { $u = $val }
                    if ($kv[0] -eq 'p') { $p = $val }
                }
            }
            if ($u -eq $PanelUser -and $p -eq $PanelPass) {
                $response.Headers.Add("Set-Cookie", "session=$SessionToken; Path=/; HttpOnly")
                $response.StatusCode = 302
                $response.Headers.Add("Location", "/panel.html")
                $response.ContentLength64 = 0
                $response.Close()
            }
            elseif ($u -eq $OperadorUser -and $p -eq $OperadorPass -and (Test-IpPrivada $request.RemoteEndPoint.Address.ToString())) {
                # Misma puerta, otra llave: las credenciales del operador
                # entran como operador y van a su web (solo red interna).
                $response.Headers.Add("Set-Cookie", "operador=$OperadorToken; Path=/; HttpOnly")
                $response.StatusCode = 302
                $response.Headers.Add("Location", "/operador.html")
                $response.ContentLength64 = 0
                $response.Close()
            } else {
                $errHtml = $LoginPage -replace '{{ERROR}}','<p class="err">Usuario o contraseña incorrectos</p>'
                Send-Response $response $errHtml "text/html" 401
            }
        }
        elseif ($path -eq "/panel.html" -or $path -eq "") {
            # --- COOKIE AUTH: comprueba sesion ---
            $cookieOk = $false
            $cookieHeader = $request.Headers["Cookie"]
            if ($cookieHeader -and $cookieHeader -match "session=([^;]+)") {
                if ($matches[1] -eq $SessionToken) { $cookieOk = $true }
            }
            if (-not $cookieOk) {
                $response.StatusCode = 302
                $response.Headers.Add("Location", "/login")
                $response.ContentLength64 = 0
                $response.Close()
                continue
            }
            if (Test-Path $PanelFile) {
                $html = Get-Content $PanelFile -Raw -Encoding UTF8
                $html = $html -replace '\{\{SALA_NOMBRE\}\}', $SALA_NOMBRE
                Send-Response $response $html "text/html"
            } else {
                Send-Response $response "Panel no encontrado en el servidor" "text/html" 404
            }
        }
        elseif ($path -eq "/login-operador" -and $method -eq "GET") {
            # Solo red interna: desde fuera ni siquiera existe el login
            if (-not (Test-IpPrivada $request.RemoteEndPoint.Address.ToString())) {
                Send-Response $response "Solo accesible desde la red interna" "text/html" 403
            } else {
                Send-Response $response ($LoginOperadorPage -replace '{{ERROR}}','') "text/html"
            }
        }
        elseif ($path -eq "/login-operador" -and $method -eq "POST") {
            if (-not (Test-IpPrivada $request.RemoteEndPoint.Address.ToString())) {
                Send-Response $response "Solo accesible desde la red interna" "text/html" 403
            } else {
                $formBody = ""
                try { $r2 = New-Object System.IO.StreamReader($request.InputStream); $formBody = $r2.ReadToEnd(); $r2.Close() } catch {}
                $u = ""; $p = ""
                foreach ($pair in $formBody.Split('&')) {
                    $kv = $pair.Split('=',2)
                    if ($kv.Count -eq 2) {
                        $val = [System.Uri]::UnescapeDataString($kv[1].Replace('+',' '))
                        if ($kv[0] -eq 'u') { $u = $val }
                        if ($kv[0] -eq 'p') { $p = $val }
                    }
                }
                if ($u -eq $OperadorUser -and $p -eq $OperadorPass) {
                    $response.Headers.Add("Set-Cookie", "operador=$OperadorToken; Path=/; HttpOnly")
                    $response.StatusCode = 302
                    $response.Headers.Add("Location", "/operador.html")
                    $response.ContentLength64 = 0
                    $response.Close()
                } else {
                    $errHtml = $LoginOperadorPage -replace '{{ERROR}}','<p class="err">Usuario o contraseña incorrectos</p>'
                    Send-Response $response $errHtml "text/html" 401
                }
            }
        }
        elseif ($path -eq "/operador.html") {
            if (-not (Test-IpPrivada $request.RemoteEndPoint.Address.ToString())) {
                Send-Response $response "Solo accesible desde la red interna" "text/html" 403
            } else {
                $cookieOp = $false
                $cookieHeader = $request.Headers["Cookie"]
                if ($cookieHeader -and $cookieHeader -match "operador=([^;]+)" -and $matches[1] -eq $OperadorToken) { $cookieOp = $true }
                if ($cookieHeader -and $cookieHeader -match "session=([^;]+)" -and $matches[1] -eq $SessionToken) { $cookieOp = $true }
                if (-not $cookieOp) {
                    $response.StatusCode = 302
                    $response.Headers.Add("Location", "/login-operador")
                    $response.ContentLength64 = 0
                    $response.Close()
                }
                elseif (Test-Path $OperadorFile) {
                    $html = Get-Content $OperadorFile -Raw -Encoding UTF8
                    $html = $html -replace '\{\{SALA_NOMBRE\}\}', $SALA_NOMBRE
                    Send-Response $response $html "text/html"
                } else {
                    Send-Response $response "Falta operador.html en el servidor" "text/html" 404
                }
            }
        }
        elseif ($path -eq "/api/kiosks" -and $method -eq "GET") {
            $all = @(Get-AllKiosks)
            if ($all.Count -eq 0) { $jsonOut = "[]" }
            elseif ($all.Count -eq 1) { $jsonOut = "[" + ($all[0] | ConvertTo-Json -Depth 10 -Compress) + "]" }
            else { $jsonOut = $all | ConvertTo-Json -Depth 10 -Compress }
            Send-Response $response $jsonOut
        }
        elseif ($path -eq "/api/kiosk/checkin" -and $method -eq "POST") {
            $body = Get-RequestBody $request
            if ($body -and $body.uid) {
                if ($body.matricula -ne "" -and $body.matricula -notmatch "PLANETAS|SIGNAGE|CALENDARIO") {
                    try {
                        $pingObj = New-Object System.Net.NetworkInformation.Ping
                        Get-ChildItem $KiosksPath -Filter "*.json" | ForEach-Object {
                            $old = Get-Content $_.FullName -Raw -Encoding UTF8 | ConvertFrom-Json
                            if ($old.uid -ne $body.uid -and $old.matricula -eq $body.matricula) {
                                $isOn = $false
                                try { if ($pingObj.Send($old.ip_actual, 300).Status -eq 'Success') { $isOn = $true } } catch {}
                                if (-not $isOn) {
                                    try {
                                        $tcpObj = New-Object System.Net.Sockets.TcpClient
                                        $arObj = $tcpObj.BeginConnect($old.ip_actual, 135, $null, $null)
                                        if ($arObj.AsyncWaitHandle.WaitOne(300)) { $tcpObj.EndConnect($arObj); $isOn = $true }
                                        $tcpObj.Close()
                                    } catch {}
                                }
                                if (-not $isOn) { Remove-Item $_.FullName -Force -ErrorAction SilentlyContinue }
                            }
                        }
                    } catch {}
                }
                $d = Read-KioskData $body.uid; if (-not $d) { $d = New-KioskData $body.uid }
    $d.matricula = $body.matricula; $d.ip_actual = $body.ip_actual; $d.hostname = $body.hostname; $d.puesto = $body.puesto; $d.ultima_conexion = $body.ultima_conexion
    if ($body.nombre_maquina) { $d | Add-Member -MemberType NoteProperty -Name "nombre_maquina" -Value $body.nombre_maquina -Force }
    if ($null -ne $body.qr_status) { $d | Add-Member -MemberType NoteProperty -Name "qr_status" -Value $body.qr_status -Force }
    if ($null -ne $body.pv_status) { $d | Add-Member -MemberType NoteProperty -Name "pv_status" -Value $body.pv_status -Force }
                Save-KioskData $body.uid $d; Send-Response $response '{"ok":true}'
            } else {
                Send-Response $response '{"error":"checkin invalido"}' -Status 400
            }
        }
        elseif ($path -eq "/api/kiosk/sync" -and $method -eq "POST") {
            $body = Get-RequestBody $request
            if ($body -and $body.ip -and $null -ne $body.activos) {
                $activosArray = @($body.activos)
                Get-ChildItem -Path $KiosksPath -Filter "*.json" | ForEach-Object {
                    try {
                        $k = Get-Content $_.FullName -Raw -Encoding UTF8 | ConvertFrom-Json
                        if ($k.ip_actual -eq $body.ip -and $activosArray -notcontains $k.uid) { Remove-Item -Path $_.FullName -Force }
                    } catch {}
                }
                Send-Response $response '{"ok":true}'
            } else {
                Send-Response $response '{"error":"sync invalido"}' -Status 400
            }
        }
        elseif ($path -match "^/api/kiosk/([^/]+)/commands$" -and $method -eq "GET") {
            $uid = $matches[1]; $data = Read-KioskData $uid
            if ($data) { Send-Response $response ($data | ConvertTo-Json -Depth 10 -Compress) }
            else { Send-Response $response '{"comandos_pendientes":{}}' }
        }
        elseif ($path -match "^/api/kiosk/([^/]+)/commands$" -and $method -eq "POST") {
            $uid = $matches[1]; $body = Get-RequestBody $request
            if ($body) {
                # Sesion de operador: solo sus tres comandos y solo a $true.
                # Cualquier otra clave (matriculas, IP, settings, version...)
                # se rechaza entera: el operador no puede colar nada mas.
                $bloqueadoOperador = $false
                if ($esOperador) {
                    foreach ($prop in $body.PSObject.Properties) {
                        if (@("corregir_imagen","reiniciar_pc","apagar_pc") -notcontains $prop.Name -or $prop.Value -ne $true) { $bloqueadoOperador = $true }
                    }
                }
                if ($bloqueadoOperador) { Send-Response $response '{"error":"accion no permitida para operador"}' -Status 403 }
                elseif ($uid -eq "TODAS") {
                    $all = @(Get-KiosksRaw); foreach ($k in $all) {
                        $d = Read-KioskData $k.uid; if (-not $d) { $d = New-KioskData $k.uid }
                        foreach ($prop in $body.PSObject.Properties) { $d.comandos_pendientes | Add-Member -MemberType NoteProperty -Name $prop.Name -Value $prop.Value -Force }
                        Save-KioskData $k.uid $d
                    }; foreach ($ip in ($all.ip_actual | select -Unique)) { if($ip){Push-Encolar $ip} }
                    Send-Response $response '{"ok":true}'
                } else {
                    $d = Read-KioskData $uid; if (-not $d) { $d = New-KioskData $uid }
                    foreach ($prop in $body.PSObject.Properties) { $d.comandos_pendientes | Add-Member -MemberType NoteProperty -Name $prop.Name -Value $prop.Value -Force }
                    Save-KioskData $uid $d; if ($d.ip_actual) { Push-Encolar $d.ip_actual }
                    Send-Response $response '{"ok":true}'
                }
            } else {
                Send-Response $response '{"error":"sin cuerpo"}' -Status 400
            }
        }
        elseif ($path -match "^/api/kiosk/([^/]+)/clear$" -and $method -eq "POST") {
            $uid = $matches[1]; $body = Get-RequestBody $request; $d = Read-KioskData $uid
            if ($d -and $body) {
                foreach ($prop in $body.PSObject.Properties) { $d.comandos_pendientes | Add-Member -MemberType NoteProperty -Name $prop.Name -Value $prop.Value -Force }
                Save-KioskData $uid $d; Send-Response $response '{"ok":true}'
            } else {
                Send-Response $response '{"error":"clear invalido"}' -Status 400
            }
        }
        elseif ($path -match "^/api/kiosk/([^/]+)$" -and $method -eq "DELETE") {
            $f = Get-KioskFile $matches[1]; if (Test-Path $f) { Remove-Item $f -Force; Send-Response $response '{"ok":true}' } else { Send-Response $response '{"ok":false}' -Status 404 }
        }
        elseif ($path -eq "/api/version" -and $method -eq "GET") {
            $v = "1.0"; if (Test-Path $VersionFile) { $v = (Get-Content $VersionFile -Raw).Trim() }
            Send-Response $response ('{"version":"' + $v + '"}')
        }
        elseif ($path -eq "/api/version" -and $method -eq "POST") {
            $body = Get-RequestBody $request
            if ($body -and $body.version) {
                Write-ApiLog "Recibida solicitud web para cambiar version a: $($body.version)"
                try {
                    $dirVersion = Split-Path $VersionFile -Parent
                    if (-not (Test-Path $dirVersion)) { New-Item -ItemType Directory -Path $dirVersion -Force | Out-Null }
                    Set-Content -Path $VersionFile -Value $body.version -Encoding UTF8 -Force
                    Write-ApiLog "✅ Version guardada con exito en: $VersionFile"
                    Send-Response $response '{"ok":true}'
                } catch {
                    Write-ApiLog "[!] ERROR CRITICO escribiendo version.txt: $($_.Exception.Message)"
                    Send-Response $response '{"ok":false}' -Status 500
                }
            } else {
                Send-Response $response '{"error":"Cuerpo del mensaje invalido"}' -Status 400
            }
        }
        else {
            Send-Response $response '{"error":"ruta no encontrada"}' -Status 404
        }
    } catch { try { $context.Response.Close() } catch {} }
}
} finally {
    $mutex.ReleaseMutex()
    $mutex.Dispose()
}